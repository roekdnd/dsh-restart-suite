{
  "name": "dsh-restart-suite",
  "version": "0.1.3",
  "type": "module",
  "description": "重启应用：agent/按钮两条入口的重启，以及重启后的唤醒与续跑善后。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roekdnd/dsh-restart-suite.git"
  },
  "homepage": "https://github.com/roekdnd/dsh-restart-suite#readme",
  "bugs": {
    "url": "https://github.com/roekdnd/dsh-restart-suite/issues"
  },
  "author": "roekdnd",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "restart",
    "session-resume",
    "windows"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "core/",
    "engine/",
    "after/",
    "scripts/*.ps1",
    "scripts/say.js",
    "test/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22"
  }
}
